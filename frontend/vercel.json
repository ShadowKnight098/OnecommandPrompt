{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://onecommand-api.onrender.com/api/:path*" },
    { "source": "/i/:path*", "destination": "https://onecommand-api.onrender.com/i/:path*" }
  ]
}
